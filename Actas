<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generador de Actas de Reunión con IA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.0.0/dist/signature_pad.umd.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .signature-canvas {
            border: 1px solid #e2e8f0;
            border-radius: 0.5rem;
            cursor: crosshair;
        }
        #acta-preview {
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body class="bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-200">
    <div class="container mx-auto p-4 md:p-8">
        <header class="text-center mb-8">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">Generador de Actas de Reunión</h1>
            <p class="text-gray-600 dark:text-gray-400 mt-2">Completa los datos, añade las firmas y genera un PDF profesional con ayuda de IA.</p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Columna de Formulario -->
            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
                <h2 class="text-2xl font-semibold mb-6 border-b pb-3 dark:border-gray-600">1. Datos de la Reunión</h2>
                <form id="acta-form" class="space-y-4">
                    <div>
                        <label for="fecha" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Fecha</label>
                        <input type="date" id="fecha" name="fecha" required class="mt-1 block w-full bg-gray-50 dark:bg-gray-700 border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm p-2">
                    </div>
                    <div>
                        <label for="comite" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Comité</label>
                        <select id="comite" name="comite" required class="mt-1 block w-full bg-gray-50 dark:bg-gray-700 border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm p-2">
                            <option>Comité de Calidad</option>
                            <option>Comité de Consulta</option>
                            <option>Comité Curricular</option>
                        </select>
                    </div>
                    <div>
                        <label for="asunto" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Asunto Principal</label>
                        <input type="text" id="asunto" name="asunto" placeholder="Ej: Revisión del plan de estudios 2024" required class="mt-1 block w-full bg-gray-50 dark:bg-gray-700 border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm p-2">
                    </div>
                    <div>
                        <label for="participantes" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Miembros Participantes (uno por línea)</label>
                        <textarea id="participantes" name="participantes" rows="4" placeholder="Dr. Juan Pérez&#10;Dra. Ana Gómez&#10;Ing. Carlos Ruiz" required class="mt-1 block w-full bg-gray-50 dark:bg-gray-700 border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm p-2"></textarea>
                    </div>
                    <div class="flex justify-end pt-4">
                         <button type="button" id="setup-firmas-btn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition duration-300">
                            Configurar Firmas
                        </button>
                    </div>
                </form>

                <div id="firmas-container" class="mt-8 hidden">
                    <h2 class="text-2xl font-semibold mb-6 border-b pb-3 dark:border-gray-600">2. Firmas de los Participantes</h2>
                    <div id="firmas-grid" class="space-y-6"></div>
                    <div class="flex justify-end pt-6">
                        <button id="generate-btn" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg transition duration-300">
                           Generar Acta con IA
                        </button>
                    </div>
                </div>

            </div>

            <!-- Columna de Vista Previa -->
            <div class="bg-gray-50 dark:bg-gray-800 p-6 rounded-lg shadow-inner">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-2xl font-semibold">Vista Previa del Acta</h2>
                    <button id="download-btn" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg transition duration-300 hidden">
                        Descargar PDF
                    </button>
                </div>
                <div id="loader" class="text-center p-10 hidden">
                    <svg class="animate-spin h-8 w-8 text-blue-500 mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <p class="mt-4">La IA está redactando el acta... Por favor, espera.</p>
                </div>
                <div id="acta-preview-container" class="bg-white dark:bg-gray-900 p-8 rounded-lg min-h-[600px] text-sm">
                    <div id="acta-content" class="prose dark:prose-invert max-w-none">
                        <p class="text-gray-400">El contenido del acta aparecerá aquí después de ser generado.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const setupFirmasBtn = document.getElementById('setup-firmas-btn');
        const participantesTextarea = document.getElementById('participantes');
        const firmasContainer = document.getElementById('firmas-container');
        const firmasGrid = document.getElementById('firmas-grid');
        const generateBtn = document.getElementById('generate-btn');
        const loader = document.getElementById('loader');
        const actaContent = document.getElementById('acta-content');
        const downloadBtn = document.getElementById('download-btn');
        const actaPreviewContainer = document.getElementById('acta-preview-container');
        const form = document.getElementById('acta-form');

        let signaturePads = {};

        // Función para configurar los campos de firma
        setupFirmasBtn.addEventListener('click', () => {
            const participantes = participantesTextarea.value.trim().split('\n').filter(p => p);
            if (participantes.length === 0) {
                alert('Por favor, ingresa al menos un participante.');
                return;
            }

            firmasGrid.innerHTML = '';
            signaturePads = {};

            participantes.forEach((participante, index) => {
                const id = `signature-pad-${index}`;
                const firmaHTML = `
                    <div class="firma-block">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">${participante}</label>
                        <canvas id="${id}" class="signature-canvas bg-white dark:bg-gray-700 w-full h-32 mt-1"></canvas>
                        <button type="button" data-clear-id="${id}" class="clear-btn mt-2 text-xs text-blue-500 hover:text-blue-700">Limpiar</button>
                    </div>
                `;
                firmasGrid.innerHTML += firmaHTML;
            });
            
            // Inicializar Signature Pad en cada canvas
            setTimeout(() => {
                participantes.forEach((p, index) => {
                    const canvas = document.getElementById(`signature-pad-${index}`);
                    // Ajustar para alta resolución
                    const ratio =  Math.max(window.devicePixelRatio || 1, 1);
                    canvas.width = canvas.offsetWidth * ratio;
                    canvas.height = canvas.offsetHeight * ratio;
                    canvas.getContext("2d").scale(ratio, ratio);
                    signaturePads[p] = new SignaturePad(canvas, {
                         backgroundColor: 'rgba(255, 255, 255, 0)'
                    });
                });
            }, 0);

            firmasContainer.classList.remove('hidden');
            setupFirmasBtn.classList.add('hidden');
        });

        // Event listener para botones de limpiar firma
        firmasGrid.addEventListener('click', (e) => {
            if (e.target.classList.contains('clear-btn')) {
                const id = e.target.dataset.clearId;
                const participante = Object.keys(signaturePads).find(key => signaturePads[key].canvas.id === id);
                if (participante && signaturePads[participante]) {
                    signaturePads[participante].clear();
                }
            }
        });

        // Generar el acta con IA
        generateBtn.addEventListener('click', async () => {
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            loader.classList.remove('hidden');
            actaContent.innerHTML = '<p class="text-gray-400">El contenido del acta aparecerá aquí después de ser generado.</p>';
            downloadBtn.classList.add('hidden');

            const formData = new FormData(form);
            const fecha = formData.get('fecha');
            const comite = formData.get('comite');
            const asunto = formData.get('asunto');
            const participantes = formData.get('participantes').trim().split('\n');

            const systemPrompt = `
                Eres un asistente administrativo experto en la redacción de documentos oficiales. Tu tarea es generar un acta de reunión formal, clara y profesional.
                Utiliza el siguiente formato y tono:

                ESTRUCTURA DEL ACTA:
                1.  **Encabezado:** Incluye "ACTA DE REUNIÓN", el nombre del comité y la fecha.
                2.  **Apertura:** Menciona la hora de inicio (supón las 10:00 a.m.), el lugar (supón "Sala de Juntas Virtual") y la lista de participantes.
                3.  **Orden del Día:** Presenta el asunto principal de la reunión como el punto central de la agenda.
                4.  **Desarrollo de la Reunión:** Elabora de forma detallada sobre el asunto. Expande los puntos clave, las discusiones más importantes, las opiniones presentadas y los análisis realizados. Debes ser coherente y desarrollar el tema de manera lógica.
                5.  **Acuerdos y Decisiones:** Resume en puntos numerados los acuerdos concretos a los que se llegaron. Si no hay acuerdos explícitos, resume las conclusiones principales.
                6.  **Cierre:** Indica la hora de finalización de la reunión (supón una duración de 1.5 horas) y la conformidad de los participantes.
                7.  **Firmas:** Deja un espacio que será llenado posteriormente.

                TONO:
                - Formal, objetivo y conciso.
                - Utiliza un lenguaje claro y profesional.
                - No uses jerga ni abreviaturas no estándar.
            `;

            const userQuery = `
                Genera el acta para la siguiente reunión:
                - **Comité:** ${comite}
                - **Fecha:** ${fecha}
                - **Asunto Principal:** ${asunto}
                - **Participantes:**\n${participantes.join('\n')}
            `;

            try {
                const apiKey = "";
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${apiKey}`;

                const payload = {
                    contents: [{ parts: [{ text: userQuery }] }],
                    systemInstruction: {
                        parts: [{ text: systemPrompt }]
                    },
                };
                
                // Exponential backoff
                let response;
                let delay = 1000;
                for (let i = 0; i < 5; i++) {
                    response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (response.status === 200) break;
                    if (response.status === 429 || response.status >= 500) {
                       await new Promise(resolve => setTimeout(resolve, delay));
                       delay *= 2;
                    } else {
                       break;
                    }
                }

                if (!response.ok) {
                    throw new Error(`Error en la API: ${response.statusText}`);
                }

                const result = await response.json();
                let generatedText = result.candidates[0].content.parts[0].text;
                
                // Convertir Markdown a HTML simple
                generatedText = generatedText
                    .replace(/## (.*)/g, '<h2 class="text-lg font-bold mt-4 mb-2">$1</h2>')
                    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
                    .replace(/\* (.*)/g, '<li class="ml-5 list-disc">$1</li>')
                    .replace(/\n/g, '<br>');
                
                // Montar el HTML final
                actaContent.innerHTML = `
                    ${generatedText}
                    <h2 class="text-lg font-bold mt-8 mb-4">Firmas de Conformidad:</h2>
                    <div id="firmas-preview" class="grid grid-cols-2 md:grid-cols-3 gap-6 mt-4">
                        ${participantes.map((p, i) => `
                            <div class="text-center p-2 border-t-2 border-gray-400">
                                <img src="${signaturePads[p].isEmpty() ? 'https://placehold.co/200x80/FFFFFF/FFFFFF?text=.' : signaturePads[p].toDataURL()}" alt="Firma de ${p}" class="mx-auto h-16 object-contain">
                                <p class="text-xs font-semibold mt-2">${p}</p>
                            </div>
                        `).join('')}
                    </div>
                `;
                downloadBtn.classList.remove('hidden');

            } catch (error) {
                console.error("Error al generar el acta:", error);
                actaContent.innerHTML = '<p class="text-red-500">Hubo un error al contactar con la IA. Por favor, intenta de nuevo más tarde.</p>';
            } finally {
                loader.classList.add('hidden');
            }
        });

        // Descargar el PDF
        downloadBtn.addEventListener('click', () => {
            const { jsPDF } = window.jspdf;
            const element = document.getElementById('acta-preview-container');
            
            html2canvas(element, {
                scale: 2, // Aumentar la escala para mejor resolución
                useCORS: true 
            }).then(canvas => {
                const imgData = canvas.toDataURL('image/png');
                const pdf = new jsPDF('p', 'mm', 'a4');
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = pdf.internal.pageSize.getHeight();
                const canvasWidth = canvas.width;
                const canvasHeight = canvas.height;
                const ratio = canvasWidth / canvasHeight;
                const imgWidth = pdfWidth - 20; // con márgenes
                const imgHeight = imgWidth / ratio;
                
                let heightLeft = imgHeight;
                let position = 10;
                
                pdf.addImage(imgData, 'PNG', 10, position, imgWidth, imgHeight);
                heightLeft -= pdfHeight;

                while (heightLeft > 0) {
                    position = heightLeft - imgHeight + 10;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 10, position, imgWidth, imgHeight);
                    heightLeft -= pdfHeight;
                }
                
                pdf.save(`Acta-${form.comite.value.replace(/\s/g, '_')}-${form.fecha.value}.pdf`);
            });
        });
        
        // Setea la fecha de hoy por defecto
        document.getElementById('fecha').valueAsDate = new Date();

    </script>
</body>
</html>
